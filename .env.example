# MeteoLens environment variables — NAMES ONLY, never commit real values.
# Copy to .env for local development (.env is gitignored).

# Required. Local dev: `supabase status` prints API_URL and SECRET_KEY for the
# local stack (this project runs on the +10 port shift, 54331). On Render these
# point at the cloud project instead.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required. Power BI streaming-dataset Push URL (embeds an API key — secret).
# Set in the Render dashboard from M7; any non-empty placeholder works locally
# until the dataset exists.
POWERBI_PUSH_URL=

# Required. Shared secret for POST /api/ingest (Authorization: Bearer <token>).
INGEST_TOKEN=

# Optional. Power BI Publish-to-web embed URL; the page shows a "report pending"
# placeholder while this is unset.
POWERBI_EMBED_URL=
